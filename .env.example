# Copie de référence des réglages. Les vraies valeurs se collent dans
# Vercel > Project > Settings > Environment Variables, jamais dans ce fichier.
# Sans ces deux valeurs, l'app tourne en « mode démo » (données d'exemple, rien n'est enregistré en ligne).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique du site, pour les liens de connexion par email
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Semaine 2 : clé de la console Claude (côté serveur uniquement)
ANTHROPIC_API_KEY=
